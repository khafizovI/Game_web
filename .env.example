DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false

# URLs you will fill after Render + Netlify deploy
BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.netlify.app

# Render host
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,your-backend.onrender.com

# Frontend/backend origins
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://your-backend.onrender.com,https://your-frontend.netlify.app
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-frontend.netlify.app
CORS_ALLOW_CREDENTIALS=true

# Separate frontend + backend over HTTPS
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_LANGUAGE_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None
DJANGO_LANGUAGE_COOKIE_SAMESITE=None
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false

# Database
# Render free local sqlite is not persistent. Use external Postgres here.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
DATABASE_CONN_HEALTH_CHECKS=true

# Email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
